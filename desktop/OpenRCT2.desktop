[Desktop Entry]
Version=1.0
Type=Application
Name=OpenRCT2
GenericName=Amusement Park Simulator
Comment=An open source re-implementation of RollerCoaster Tycoon 2
Keywords=rct;tycoon;rollercoaster;roller coaster tycoon;simulation;
Categories=Game;Simulation;StrategyGame;
Exec=/opt/OpenRCT2/OpenRCT2.AppImage %F
Icon=__HOME__/.local/share/icons/OpenRCT2.png
Terminal=false
StartupWMClass=openrct2
MimeType=application/x-openrct2-park;application/x-openrct2-scenario;application/x-openrct2-track;
